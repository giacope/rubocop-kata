#!/usr/bin/env ruby
# frozen_string_literal: true

require "set"
require "zlib"

module RuboCop
  module Kata
  end
end

module Lexicography
end

require_relative "../lib/rubocop/kata/agency"

class Lexicography::Synset
  AGENTIVE = %w[05 06 10 14 18 19 27].freeze
  PERSON = "18"

  def initialize(line)
    head, @gloss = line.split(" | ", 2)
    @fields = head.split
  end

  def person? = @fields[1] == PERSON

  def lexical? = AGENTIVE.include?(@fields[1])

  def words = (0...count).map { @fields[4 + (2 * it)].downcase }

  def derived(word)
    position = words.index(word)
    return [] unless position
    pointers.select { |symbol, _, kind, link| symbol == "+" && kind == "v" && link[0, 2].to_i(16) == position + 1 }
      .map { |_, offset, _, link| [offset, link[2, 2].to_i(16) - 1] }
  end

  def glossed?(verb) = (forms(verb) - words).any? { @gloss.to_s.match?(/\b#{Regexp.escape(it)}\b/i) }

  private

  def count = @fields[3].to_i(16)

  def pointers
    start = 5 + (2 * count)
    @fields[start..].each_slice(4).first(@fields[start - 1].to_i)
  end

  def forms(verb)
    found = [verb, "#{verb}s", "#{verb}es", "#{verb}d", "#{verb}ed", "#{verb}ing"]
    found += [verb.sub(/e\z/, "ing"), verb.sub(/e\z/, "ed")] if verb.end_with?("e")
    found += ["#{verb}#{verb[-1]}ing", "#{verb}#{verb[-1]}ed"] if verb.match?(/[^aeiou][aeiou][b-df-hj-np-tv-z]\z/)
    found += [verb.sub(/y\z/, "ies"), verb.sub(/y\z/, "ied")] if verb.end_with?("y")
    found
  end
end

class Lexicography::Wordnet
  NOUN = /\A[a-z]+(?:er|or|ar)\z/
  WORD = /\A[a-z]+\z/

  def initialize(dict)
    @dict = dict
  end

  def write(target)
    agents = nouns.select { agent?(it) }
    dump(File.join(target, "agents.txt.gz"), agents)
    dump(File.join(target, "things.txt.gz"), nouns - agents)
    dump(File.join(target, "verbs.txt.gz"), verbs.to_a.grep(WORD))
  end

  private

  def agent?(word)
    candidates = RuboCop::Kata::Agency.new(word).stems.select { verbs.include?(it) }
    first, second = senses(word)
    return false if candidates.empty?
    agentive?(first, word, candidates) || (first.person? && !second.nil? && agentive?(second, word, candidates))
  end

  def agentive?(sense, word, candidates)
    return false unless sense.lexical?
    linked = sense.derived(word).map { |offset, slot| Lexicography::Synset.new(verbal.fetch(offset)).words[slot] }
    candidates.intersect?(linked) || candidates.any? { sense.glossed?(it) }
  end

  def senses(word) = index("noun").fetch(word).map { Lexicography::Synset.new(nominal.fetch(it)) }

  def nouns = @_nouns ||= index("noun").keys.grep(NOUN).sort

  def verbs = @_verbs ||= Set.new(index("verb").keys)

  def index(pos)
    @_index ||= {}
    @_index[pos] ||= File.foreach(File.join(@dict, "index.#{pos}")).reject { it.start_with?(" ") }.to_h do |line|
      fields = line.split
      [fields[0], fields[(6 + fields[3].to_i)..].first(fields[2].to_i)]
    end
  end

  def nominal = @_nominal ||= data("noun")

  def verbal = @_verbal ||= data("verb")

  def data(pos)
    File.foreach(File.join(@dict, "data.#{pos}")).reject { it.start_with?(" ") }.to_h { [it[0, 8], it] }
  end

  def dump(path, words)
    Zlib::GzipWriter.open(path) do |gzip|
      gzip.mtime = 1
      gzip.write(words.sort.uniq.join("\n"))
    end
  end
end

Lexicography::Wordnet.new(ARGV.fetch(0)).write(File.expand_path("../data", __dir__))
