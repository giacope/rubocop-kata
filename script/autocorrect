#!/usr/bin/env ruby
# frozen_string_literal: true

require "rubocop"
require "yaml"

PLUGINS = %w[rubocop-elegant rubocop-rspec rubocop-performance rubocop-packaging rubocop-thread_safety].freeze
ALLOWLIST = File.expand_path("../data/autocorrect.txt", __dir__)
TARGET = File.expand_path("../config/autocorrect.yml", __dir__)
HEADER = <<~YAML
  # Written by script/autocorrect from data/autocorrect.txt; edit the list, not
  # this file. `rubocop -a` applies a correction only when it changes layout or
  # delimiters, or swaps syntax for an exact equivalent that resolves no name the
  # project could define; every other correction waits for `rubocop -A`. A listed
  # correction RuboCop ships as unsafe is vouched for here (`SafeAutoCorrect: true`).
  # Run it under the oldest and the newest RuboCop the gemspec allows: it adds
  # to the entries already shipped.
YAML

PLUGINS.each { require it }
require "rubocop-kata"

allowed = File.readlines(ALLOWLIST, chomp: true).map { it.split(" ", 3) }.reject { it[1] == "held" }.map(&:first)
shipped = File.file?(TARGET) ? YAML.load_file(TARGET) : {}
correcting = RuboCop::Cop::Registry.global.cops.select(&:support_autocorrect?).map(&:cop_name)
defaults = RuboCop::ConfigLoader.default_configuration
vouched = allowed.select { shipped.dig(it, "SafeAutoCorrect") || defaults.for_cop(it)["SafeAutoCorrect"] == false }
held = (shipped.keys | correcting) - allowed
settings = (held | vouched).sort.to_h { [it, { "SafeAutoCorrect" => vouched.include?(it) }] }
File.write(TARGET, HEADER + settings.to_yaml.delete_prefix("---\n"))
